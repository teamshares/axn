name: CI

on:
  push:
    branches:
      - main
  pull_request:

jobs:
  ci:
    # Reusable workflow in axn core — fix CI once there, every gem inherits it.
    # `name` is pinned because GitHub prefixes the called jobs with THIS job name, making it
    # half of every required-status-check context ("CI / Specs (Ruby 3.2)"). Renaming it
    # invalidates this repo's branch-protection ruleset.
    name: CI
    uses: teamshares/axn/.github/workflows/gem-ci.yml@main
